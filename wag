async verifySiteWAGSGuidelines() {

        await this.page.waitForLoadState('domcontentloaded'); // Added to ensure elements exist before scanning
        await this.page.waitForSelector('#iw_comp1760337947027', { timeout: 10000 }); // Wait for the specific element to be present
        await this.base.scrollTo('#iw_comp1760337947027'); // Scroll to the element to ensure it's in view        
        const accessibilityScanResults = await new AxeBuilder({ page: this.page })
            .include('#iw_comp1736648034693')
            .disableRules(['color-contrast'])
            // Run checks for WCAG 2.0, 2.1 and 2.2 levels. If axe-core doesn't
            // include newer tags in your installed version, consider upgrading the package.
            .withTags([
                'wcag2a', 'wcag2aa',
                'wcag21a', 'wcag21aa',
                'wcag22a', 'wcag22aa'
            ])
            .analyze();

        //console.log("WAG : " + accessibilityScanResults.violations)
        // 🔴 Print formatted bugs if any violations are found
        if (accessibilityScanResults.violations.length > 0) {
            console.log(`\n❌ Found ${accessibilityScanResults.violations.length} accessibility violations:\n`);

            accessibilityScanResults.violations.forEach((violation, index) => {
                console.log(`--------------------------------------------------`);
                console.log(`Issue ${index + 1}: [${violation.id}] - ${violation.help}`);
                if (violation.tags && violation.tags.length) {
                    console.log(`Tags: ${violation.tags.join(', ')}`);
                }
                console.log(`Impact: ${violation.impact?.toUpperCase()}`);
                console.log(`More info: ${violation.helpUrl}`);
                console.log(`Affected Elements:`);

                // Print the exact HTML snippet and selector for each failing element
                violation.nodes.forEach((node) => {
                    console.log(`  - Selector: ${node.target.join(', ')}`);
                    console.log(`    HTML: ${node.html}`);
                });
            });
            console.log(`--------------------------------------------------\n`);
            // Save full report to disk for later inspection
            try {
                fs.ensureDirSync('./test-results');
                fs.writeFileSync('./test-results/accessibility-report.json', JSON.stringify(accessibilityScanResults, null, 2), 'utf-8');
                console.log('Accessibility report written to ./test-results/accessibility-report.json');
            } catch (err) {
                console.error('Failed to write accessibility report:', err);
            }

            expect(accessibilityScanResults.violations).toEqual([]);
        }
    }
